  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "mobile": "pnpm --filter mobile",
    "mobile:start": "pnpm mobile start --clear",
    "mobile:update": "pnpm mobile expo install --check",
    "web": "pnpm --filter web",
    "ext": "pnpm --filter ext",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ts-check": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write .",
    "backend:dev": "node scripts/backend-db.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-expo": "^1.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "hex-to-rgba": "^2.0.1"
  }
