{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@apps/api": ["../../packages/api/src"],
      "@apps/constants": ["../../packages/constants/src"],
      "@apps/hooks": ["../../packages/hooks/src"],
      "@apps/schemas": ["../../packages/schemas/src"],
      "@apps/tokens": ["../../packages/tokens/src"],
      "@apps/types": ["../../packages/types/src"],
      "@apps/ui": ["../../packages/ui/src"],
      "@apps/utils": ["../../packages/utils/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/**/src/**/*.ts",
    "../../packages/**/src/**/*.tsx"
  ]
}
