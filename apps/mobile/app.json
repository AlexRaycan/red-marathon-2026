{
  "expo": {
    "slug": "sagaset",
    "description": "Track and discover movies, series, anime, books, and games with personal ratings, collections, and AI recommendations.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sagaset",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.alexraycan.sagaset",
      "icon": "./assets/SagaSet.icon"
    },
    "android": {
      "package": "com.alexraycan.sagaset",
      "adaptiveIcon": {
        "backgroundColor": "#06020A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06020A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "expo-notifications",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "06bf7736-4e6e-4b57-b3d1-425d45bd1cc5"
      }
    },
    "owner": "alexraycan"
  }
}
