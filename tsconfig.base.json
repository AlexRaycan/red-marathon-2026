{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.turbo/**",
    "**/android/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/example/**",
    "**/ios/**",
    "**/out/**"
  ]
}
